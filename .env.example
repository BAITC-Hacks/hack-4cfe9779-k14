APP_NAME=Chat Service API
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://chat:change-this-local-password@localhost:5432/chat
WIDGET_ORIGIN=http://localhost:8080
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-this-local-password
API_PORT=8000
EKT_API_BASE_URL=https://ekt.kz/api/
EKT_API_USERNAME=replace-with-partner-username
EKT_API_PASSWORD=replace-with-partner-password
EKT_READ_RETRY_COUNT=1
EKT_RETRY_BACKOFF_SECONDS=0.05
CATALOG_ADAPTER_MODE=mock
# CATALOG_MOCK_DATA_PATH=/absolute/path/to/mock_catalog.json
LLM_API_URL=https://provider.example/v1/chat/completions
LLM_API_KEY=replace-with-server-side-api-key
LLM_MODEL=replace-with-model-name
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=15
LLM_HISTORY_MESSAGE_LIMIT=12
PENDING_OFFER_TTL_SECONDS=300
IDEMPOTENCY_KEY_TTL_SECONDS=86400
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_XLSX_SHEETS=20
ATTACHMENT_MAX_XLSX_ROWS=10000
ATTACHMENT_MAX_XLSX_COLUMNS=100
ATTACHMENT_LLM_MAX_CHARS=12000
ATTACHMENT_TTL_SECONDS=86400
CLEANUP_BATCH_SIZE=1000
